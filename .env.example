# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your_account_id

# Bedrock Model
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# DynamoDB Tables
AUDIT_TABLE_NAME=agentguard-audit-log
APPROVALS_TABLE_NAME=agentguard-pending-approvals

# Step Functions
APPROVAL_WORKFLOW_ARN=arn:aws:states:ap-south-1:YOUR_ACCOUNT_ID:stateMachine:agentguard-approval-workflow

# SNS
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:YOUR_ACCOUNT_ID:agentguard-approval-notifications
APPROVER_EMAIL=your_email@gmail.com

# EventBridge
EVENT_BUS_NAME=agentguard-events

# Lambda Functions (for inter-Lambda invocation)
INTERCEPTOR_FUNCTION_NAME=agentguard-interceptor
EXECUTE_TOOL_FUNCTION_NAME=agentguard-execute-tool

# Cognito
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id

# API (Frontend config)
API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/prod
